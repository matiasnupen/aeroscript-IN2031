// Quick Event Test - Simple focused test for all event types
// Perfect for quick validation of the reaction system

-> StartMode {
    // Test message reactions
    on message [go] -> ActionMode
    on message [emergency] -> EmergencyMode
}

ActionMode {
    // Actions that will consume battery and potentially hit obstacles
    ascend by 20 for 3 seconds
    move to point(30, 30) at speed 10
    turn right by 90
    move to point(50, 50) at speed 8
    descend by 10
    
    // All three event types in one mode
    on message [continue] -> ActionMode
    on message [land] -> LandingMode
    on obstacle -> AvoidanceMode
    on low_battery -> BatteryMode
} -> CompletedMode

AvoidanceMode {
    // Obstacle avoidance
    ascend by 15
    turn left by 90
    move by 25
    turn right by 90
    descend by 10
    
    on message [resume] -> ActionMode
    on low_battery -> BatteryMode
} -> ActionMode

BatteryMode {
    // Low battery handling
    move to point(0, 0) at speed 20
    descend by 15
    
    on message [charged] -> ActionMode
    on obstacle -> EmergencyMode
} -> LandingMode

LandingMode {
    // Normal landing
    return to base
    
    on message [restart] -> StartMode
}

CompletedMode {
    // Mission completed
    move to point(0, 0)
    descend to ground
    
    on message [new_mission] -> StartMode
}

EmergencyMode {
    // Emergency procedures
    descend to ground
}